  "qubes": {"icon":"󰆧","label":"Qubes","aliases":["qube","vm"],"description":"Isolated VM compartments","when":"omarchy-cmd-present qube"},
  "qubes.run": {"icon":"󰀻","label":"Run App","description":"Open an app in a qube, starting it if needed","when":"qube-menu has-qubes","action":"qube-menu run"},
  "qubes.terminal": {"icon":"󰆍","label":"Terminal","when":"qube-menu has-qubes","action":"qube-menu terminal"},
  "qubes.dispvm": {"icon":"󰩹","label":"Disposable","aliases":["dispvm"],"description":"Throwaway qube, deleted when the app closes","action":"qube-menu dispvm"},
  "qubes.start": {"icon":"󰐊","label":"Start","when":"qube-menu has-qubes","action":"qube-menu start"},
  "qubes.stop": {"icon":"󰓛","label":"Stop","when":"qube-menu has-running","action":"qube-menu stop"},
  "qubes.shell": {"icon":"󰞷","label":"Shell","description":"SSH session into a qube","when":"qube-menu has-qubes","action":"qube-menu shell"},
  "qubes.manage": {"icon":"󰒓","label":"Manage"},
  "qubes.manage.create": {"icon":"󰐕","label":"Create Qube","action":"qube-menu create"},
  "qubes.manage.label": {"icon":"󰏘","label":"Change Label","description":"The border colour its windows get","when":"qube-menu has-qubes","action":"qube-menu label"},
  "qubes.manage.delete": {"icon":"󰆴","label":"Delete Qube","when":"qube-menu has-qubes","action":"qube-menu delete"},
  "qubes.manage.template-create": {"icon":"󰏗","label":"Create Template","description":"Download Arch and install the base apps","action":"qube-menu template-create"},
  "qubes.manage.template-update": {"icon":"󰚰","label":"Update Template","action":"qube-menu template-update"},
  "qubes.manage.template-shell": {"icon":"󰆍","label":"Install Into Template","description":"Shell in the template; changes reach every qube","action":"qube-menu template-shell"},
